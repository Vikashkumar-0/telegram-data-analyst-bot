# Copy to .env for local testing. On your host (Render/Railway/etc.) set
# these as real environment variables in the dashboard instead --
# never commit real secrets to GitHub.

TELEGRAM_BOT_TOKEN=123456:your-botfather-token

# Free, no credit card: console.groq.com/keys
GROQ_API_KEY=your-groq-key
GROQ_MODEL=openai/gpt-oss-120b

# Minimum seconds between Groq calls, and how long to wait for one polite
# retry if we still hit a 429 (rate limited). One question can trigger
# several calls in a row -- these two keep us under the free-tier limit
# instead of bursting past it. Check your live limits at
# console.groq.com/settings/limits and raise/lower these to match.
GROQ_MIN_INTERVAL_SECONDS=2
GROQ_RATE_LIMIT_RETRY_SECONDS=10

# Optional but recommended -- free web search built for LLM agents,
# 1,000 searches/month free, no credit card: tavily.com
TAVILY_API_KEY=your-tavily-key

# The public HTTPS URL your host assigns this app once deployed, e.g.
# https://your-app-name.onrender.com  (no trailing slash).
# For local-only testing this can stay as http://localhost:8000.
PUBLIC_BASE_URL=http://localhost:8000

LOG_DIR=logs
PORT=8000

# Copy to .env for local testing. On your host (Render/Railway/etc.) set
# these as real environment variables in the dashboard instead --
# never commit real secrets to GitHub.

TELEGRAM_BOT_TOKEN=123456:your-botfather-token

# Free, no credit card: aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-3.6-flash


# Optional but recommended -- free web search built for LLM agents,
# 1,000 searches/month free, no credit card: tavily.com
TAVILY_API_KEY=your-tavily-key

# The public HTTPS URL your host assigns this app once deployed, e.g.
# https://your-app-name.onrender.com  (no trailing slash).
# For local-only testing this can stay as http://localhost:8000.
PUBLIC_BASE_URL=http://localhost:8000

LOG_DIR=logs
PORT=8000
